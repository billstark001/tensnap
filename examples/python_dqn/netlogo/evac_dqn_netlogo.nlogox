<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [ py ]

breed [evacuees evacuee]
breed [guides guide]
breed [trail-nodes trail-node]
undirected-link-breed [evacuee-trails evacuee-trail]

patches-own [
  wall?
  exit?
  fire?
  next-fire?
]

evacuees-own [
  alive?
  evacuated?
  target-exit-x
]

guides-own [
  preferred-exit-x
]

evacuee-trails-own [
  trail-age
]

globals [
  policy-loaded?
  loaded-guide-model
  alive-count
  evacuated-count
  dead-count
  fire-size
  total-reward
  last-reward
  training-action
  last-guide-valid?
  movement-progress
  guided-redirects
]

to setup
  clear-turtles
  clear-patches
  clear-all-plots
  set alive-count 0
  set evacuated-count 0
  set dead-count 0
  set fire-size 0
  set training-action 0
  set last-guide-valid? true
  set movement-progress 0
  set guided-redirects 0
  normalize-python-policy-state
  random-seed seed
  ifelse use-python-policy? [
    setup-python-policy
  ] [
    set loaded-guide-model "training action"
    set policy-loaded? false
  ]
  resize-world 0 (grid-width - 1) 0 (grid-height - 1)
  setup-map
  setup-agents
  set total-reward 0
  set last-reward 0
  update-counts
  reset-ticks
  update-metric-plots
end

to go
  if done? [ stop ]

  age-agent-trails
  let previous-evacuated evacuated-count
  let previous-dead dead-count
  set movement-progress 0
  set guided-redirects 0
  move-guide guide-action
  apply-guide-signal

  ask evacuees with [alive? and not evacuated?] [
    evacuee-step
  ]

  if (ticks + 1) mod fire-spread-interval = 0 [
    spread-fire
    resolve-fire-exposure
  ]

  update-counts
  tick-advance 1
  set last-reward (compute-reward
    (evacuated-count - previous-evacuated)
    (dead-count - previous-dead))
  set total-reward total-reward + last-reward
  update-metric-plots
end

to normalize-python-policy-state
  if policy-loaded? != true [
    set policy-loaded? false
  ]
end

to setup-python-policy
  normalize-python-policy-state
  if not use-python-policy? [
    set loaded-guide-model "python disabled"
    set policy-loaded? false
    stop
  ]
  if not policy-loaded? [
    let python-command resolved-python-executable
    carefully [
      py:setup python-command
      py:set "repo_root_setting" repo-root
      (py:run
        "from pathlib import Path"
        "import sys"
        "repo_root_setting = str(repo_root_setting)"
        "candidates = []"
        "if repo_root_setting and repo_root_setting != 'auto':"
        "    candidates.append(Path(repo_root_setting).expanduser())"
        "candidates.extend([Path.cwd(), *Path.cwd().parents])"
        "repo_path = next((p.resolve() for p in candidates if (p / 'examples' / 'python_dqn').exists()), None)"
        "if repo_path is None:"
        "    raise RuntimeError('Set repo-root to the tensnap repository path.')"
        "examples_path = str(repo_path / 'examples')"
        "if examples_path not in sys.path:"
        "    sys.path.insert(0, examples_path)"
        "import python_dqn.netlogo_policy as policy"
      )
      set policy-loaded? true
    ] [
      set loaded-guide-model (word "python setup failed: " error-message)
      set policy-loaded? false
      stop
    ]
  ]
  reset-guide-model
end

to-report resolved-python-executable
  if python-executable != "" and python-executable != "auto" [
    report python-executable
  ]
  let candidates []
  if repo-root != "" and repo-root != "auto" [
    set candidates lput (word repo-root "/.venv/bin/python") candidates
    set candidates lput (word repo-root "/venv/bin/python") candidates
  ]
  set candidates sentence candidates (list
    ".venv/bin/python"
    "venv/bin/python"
    "../../.venv/bin/python"
    "../../venv/bin/python"
    "/opt/miniconda3/bin/python"
    "/opt/homebrew/bin/python3"
    "/usr/local/bin/python3"
    "/usr/bin/python3"
  )
  foreach candidates [ candidate ->
    if file-exists? candidate [
      report candidate
    ]
  ]
  report "python3"
end

to reset-guide-model
  normalize-python-policy-state
  if not use-python-policy? [
    set loaded-guide-model "python disabled"
    set policy-loaded? false
    stop
  ]
  if not policy-loaded? [
    setup-python-policy
    stop
  ]
  py:set "checkpoint_dir_setting" checkpoint-dir
  py:set "checkpoint_name_setting" guide-model
  py:set "seed_setting" seed
  py:set "width_setting" grid-width
  py:set "height_setting" grid-height
  py:set "evacuees_setting" num-evacuees
  py:set "max_steps_setting" max-steps
  carefully [
    set loaded-guide-model py:runresult
      "policy.setup(checkpoint_dir=checkpoint_dir_setting or None, checkpoint_name=checkpoint_name_setting, seed=int(seed_setting), width=int(width_setting), height=int(height_setting), num_evacuees=int(evacuees_setting), max_steps=int(max_steps_setting))"
  ] [
    set loaded-guide-model (word "python model failed: " error-message)
    set policy-loaded? false
  ]
end

to setup-map
  ask patches [
    set wall? false
    set exit? false
    set fire? false
    set next-fire? false
    set pcolor white
  ]
  let center-y floor (grid-height / 2)
  ask patch 0 center-y [ set exit? true ]
  ask patch (grid-width - 1) center-y [ set exit? true ]

  let left-wall-x max list 1 (floor (grid-width / 4))
  let right-wall-x min list (grid-width - 2) (grid-width - 1 - left-wall-x)
  ask patches with [pycor != center-y] [
    if pxcor = left-wall-x or pxcor = right-wall-x [
      set wall? true
    ]
  ]
  let fire-candidates (patch-set
    (patch (min list (grid-width - 2) (left-wall-x + 1)) center-y)
    (patch (max list 1 (right-wall-x - 1)) center-y))
  ask one-of fire-candidates [ set fire? true ]
  update-patch-colors
end

to setup-agents
  let center-x floor (grid-width / 2)
  let center-y floor (grid-height / 2)
  ask patch center-x center-y [
    sprout-guides 1 [
      set color blue
      set shape "default"
      set size 1.1
      set preferred-exit-x -1
    ]
  ]
  repeat num-evacuees [
    let spawn one-of central-spawn-patches
    if spawn != nobody [
      ask spawn [
        sprout-evacuees 1 [
          set alive? true
          set evacuated? false
          set color orange
          set shape "default"
          set size 0.75
          set target-exit-x default-exit-x self
        ]
      ]
    ]
  ]
end

to-report central-spawn-patches
  let wall-columns sort remove-duplicates [pxcor] of patches with [wall?]
  let left-x max list 0 (floor (grid-width / 3))
  let right-x min list (grid-width - 1) (floor ((2 * grid-width) / 3))
  if length wall-columns >= 2 [
    set left-x (first wall-columns) + 1
    set right-x (last wall-columns) - 1
  ]
  let center-y floor (grid-height / 2)
  report patches with [
    pxcor >= left-x and pxcor <= right-x
    and pycor >= max list 0 (center-y - 3)
    and pycor <= min list (grid-height - 1) (center-y + 3)
    and not wall? and not exit? and not fire? and not any? turtles-here
  ]
end

to-report default-exit-x [agent]
  let left-distance manhattan-patches ([patch-here] of agent) (left-exit-patch)
  let right-distance manhattan-patches ([patch-here] of agent) (right-exit-patch)
  if left-distance < right-distance [ report 0 ]
  if right-distance < left-distance [ report grid-width - 1 ]
  report [pxcor] of one-of patches with [exit?]
end

to-report open-spawn-patches
  report patches with [
    not wall? and not exit? and not fire? and not any? turtles-here
  ]
end

to-report done?
  report evacuated-count + dead-count = count evacuees
    or ticks >= max-steps
end

to-report fire-fully-spread?
  report fire-size >= count burnable-patches
end

to-report burnable-patches
  report patches with [not wall? and not exit?]
end

to-report guide-action
  if use-python-policy? [
    report python-guide-action
  ]
  report training-action
end

to-report python-guide-action
  if not use-python-policy? or not policy-loaded? [
    report training-action
  ]
  py:set "state_values" dqn-state-values
  report normalized-action-code (py:runresult "policy.select_action(state_values)")
end

to move-guide [action-code]
  set action-code (normalized-action-code action-code)
  set last-guide-valid? true
  let deltas [[0 0] [0 -1] [0 1] [-1 0] [1 0]]
  let delta item action-code deltas
  ask guides [
    if action-code = 3 [ set preferred-exit-x 0 ]
    if action-code = 4 [ set preferred-exit-x grid-width - 1 ]
    let target patch (xcor + item 0 delta) (ycor + item 1 delta)
    ifelse valid-guide-target? target [
      move-to target
    ] [
      if action-code != 0 [ set last-guide-valid? false ]
    ]
  ]
end

to apply-guide-signal
  if not any? guides [ stop ]
  let selected-exit [preferred-exit-x] of one-of guides
  if selected-exit < 0 [ stop ]
  let gp guide-patch
  ask evacuees with [
    alive? and not evacuated?
    and manhattan-patches patch-here gp <= guide-influence-radius
    and target-exit-x != selected-exit
  ] [
    if random-float 1 <= guide-follow-bias [
      set target-exit-x selected-exit
      set guided-redirects guided-redirects + 1
    ]
  ]
end

to evacuee-step
  ifelse ([fire?] of patch-here) [
    set alive? false
    set color gray
  ] [
    let previous-patch patch-here
    let target-patch target-exit-patch self
    let before-distance route-distance patch-here target-patch
    let candidates (patch-set patch-here neighbors4) with [not wall? and not fire?]
    if any? candidates [
      let best max-one-of candidates [evacuee-target-score myself self]
      move-to best
    ]
    if patch-here != previous-patch [
      add-evacuee-trail previous-patch patch-here color
    ]
    if [exit?] of patch-here [
      set evacuated? true
      set color green + 2
    ]
    if [fire?] of patch-here [
      set alive? false
      set color gray
    ]
    let after-distance route-distance patch-here target-patch
    if before-distance >= 0 and after-distance >= 0 [
      set movement-progress movement-progress
        + max list -1 (min list 1 (before-distance - after-distance))
    ]
  ]
end

to add-evacuee-trail [from-patch to-patch trail-color]
  let start-node nobody
  let end-node nobody
  ask from-patch [
    sprout-trail-nodes 1 [
      hide-turtle
      set size 0
      set start-node self
    ]
  ]
  ask to-patch [
    sprout-trail-nodes 1 [
      hide-turtle
      set size 0
      set end-node self
    ]
  ]
  if start-node != nobody and end-node != nobody [
    ask start-node [
      create-evacuee-trail-with end-node [
        set color trail-color
        set thickness 0.12
        set trail-age 0
      ]
    ]
  ]
end

to age-agent-trails
  ask evacuee-trails [
    set trail-age trail-age + 1
    if trail-age > 3 [
      die
    ]
  ]
  ask trail-nodes with [not any? my-links] [
    die
  ]
end

to-report evacuee-target-score [agent target]
  let target-exit target-exit-patch agent
  let route route-distance target target-exit
  let score 0
  ifelse route < 0 [
    set score -1000 + 1.2 * distance-to-nearest-fire target
  ] [
    set score -3 * route + 0.35 * distance-to-nearest-fire target
  ]
  let occupants ((evacuees-on target) with [alive? and not evacuated?])
  let occupancy count occupants
  if target != [patch-here] of agent [
    set score score - 0.9 * occupancy
  ]
  if random-float 1 < random-move-bias [
    set score score + random-float 1 - 0.5
  ]
  report score
end

to spread-fire
  ask patches [ set next-fire? false ]
  ask patches with [fire?] [
    ask neighbors4 with [not wall? and not exit?] [
      if random-float 1 < fire-spread-probability [
        set next-fire? true
      ]
    ]
  ]
  ask patches with [next-fire?] [
    set fire? true
  ]
  update-patch-colors
end

to resolve-fire-exposure
  ask evacuees with [alive? and not evacuated? and [fire?] of patch-here] [
    set alive? false
    set color gray
  ]
end

to update-patch-colors
  ask patches [
    set pcolor white
    if wall? [ set pcolor gray + 1 ]
    if exit? [ set pcolor green + 2 ]
    if fire? [ set pcolor red + 1 ]
  ]
end

to update-counts
  set alive-count count evacuees with [alive? and not evacuated?]
  set evacuated-count count evacuees with [evacuated?]
  set dead-count count evacuees with [not alive? and not evacuated?]
  set fire-size count patches with [fire?]
end

to update-metric-plots
  set-current-plot "Evacuation Outcomes"
  set-current-plot-pen "alive"
  plotxy ticks alive-count
  set-current-plot-pen "evacuated"
  plotxy ticks evacuated-count
  set-current-plot-pen "dead"
  plotxy ticks dead-count
  set-current-plot "Fire Size"
  set-current-plot-pen "fire"
  plotxy ticks fire-size
end

to-report normalized-action-code [raw-action]
  if raw-action = true [
    report 1
  ]
  if raw-action = false [
    report 0
  ]
  let action-code floor raw-action
  if action-code < 0 or action-code > 4 [
    report 0
  ]
  report action-code
end

to-report compute-reward [evacuated-delta dead-delta]
  let reward evacuated-delta * evacuation-reward
    + dead-delta * fire-reward-penalty
    + step-penalty
    + congestion-penalty * congestion
    + progress-reward * movement-progress
  if not last-guide-valid? [
    set reward reward + invalid-action-penalty
  ]
  if done? and alive-count > 0 [
    set reward reward + unresolved-penalty * alive-count
  ]
  report reward
end

to-report congestion
  report sum [
    max list 0 ((count (evacuees-here with [alive? and not evacuated?])) - 1)
  ] of patches
end

to-report count-guided-neighbors
  if not any? guides [ report 0 ]
  let gp guide-patch
  report count evacuees with [
    alive? and not evacuated? and manhattan-patches patch-here gp <= guide-influence-radius
  ]
end

to-report dqn-state-values
  let gp guide-patch
  let gx [pxcor] of gp
  let gy [pycor] of gp
  let fires patches with [fire?]
  let fx 0
  let fy 0
  if any? fires [
    set fx mean [pxcor] of fires
    set fy mean [pycor] of fires
  ]
  let evacuee-count max list 1 count evacuees
  let burnable-count max list 1 count burnable-patches
  let center-x (grid-width - 1) / 2
  let preferred-exit 0.5
  if any? guides [
    let preferred-x [preferred-exit-x] of one-of guides
    if preferred-x = 0 [ set preferred-exit 0 ]
    if preferred-x = grid-width - 1 [ set preferred-exit 1 ]
  ]
  let fire-left count fires with [pxcor < center-x]
  let fire-right count fires with [pxcor > center-x]
  let target-left count evacuees with [
    alive? and not evacuated? and target-exit-x = 0
  ]
  let target-right count evacuees with [
    alive? and not evacuated? and target-exit-x = grid-width - 1
  ]
  let guided-neighbors count-guided-neighbors
  let nearest-fire distance-to-nearest-fire gp
  report (list
    (gx / max list 1 (grid-width - 1))
    (gy / max list 1 (grid-height - 1))
    (fx / max list 1 (grid-width - 1))
    (fy / max list 1 (grid-height - 1))
    (alive-count / evacuee-count)
    (evacuated-count / evacuee-count)
    (dead-count / evacuee-count)
    (ticks / max list 1 max-steps)
    preferred-exit
    (fire-left / burnable-count)
    (fire-right / burnable-count)
    (target-left / evacuee-count)
    (target-right / evacuee-count)
    (guided-neighbors / evacuee-count)
    (nearest-fire / max list 1 (grid-width + grid-height))
    (fire-size / burnable-count))
end

to-report distance-to-nearest-fire [target]
  let fires patches with [fire?]
  if not any? fires [
    report grid-width + grid-height
  ]
  report min [manhattan-patches target self] of fires
end

to-report left-exit-patch
  report min-one-of patches with [exit?] [pxcor]
end

to-report right-exit-patch
  report max-one-of patches with [exit?] [pxcor]
end

to-report target-exit-patch [agent]
  if [target-exit-x] of agent = 0 [ report left-exit-patch ]
  report right-exit-patch
end

to-report route-distance [start target]
  if start = target [ report 0 ]
  let visited (list start)
  let frontier (list start)
  let route-steps 0
  let result -1
  while [not empty? frontier and result < 0] [
    set route-steps route-steps + 1
    let next-frontier []
    foreach frontier [current ->
      let candidate-set [neighbors4] of current
      set candidate-set candidate-set with [not wall? and not fire?]
      foreach sort candidate-set [candidate ->
        if not member? candidate visited [
          if candidate = target [ set result route-steps ]
          set visited fput candidate visited
          set next-frontier fput candidate next-frontier
        ]
      ]
    ]
    set frontier next-frontier
  ]
  report result
end

to-report guide-patch
  if not any? guides [ report nobody ]
  report [patch-here] of one-of guides
end

to-report valid-guide-target? [target]
  report target != nobody and not [wall?] of target and not [fire?] of target
end

to-report manhattan-patches [a b]
  report abs (([pxcor] of a) - ([pxcor] of b))
    + abs (([pycor] of a) - ([pycor] of b))
end
]]></code>
  <widgets>
    <view x="15" y="15" width="500" height="500" minPxcor="0" maxPxcor="16" minPycor="0" maxPycor="12" patchSize="29.0" wrappingAllowedX="false" wrappingAllowedY="false" frameRate="20.0" updateMode="1" showTickCounter="true" tickCounterLabel="ticks" fontSize="10"></view>
    <button x="535" y="15" width="75" height="40" display="setup" kind="Observer" forever="false" disableUntilTicks="false">setup</button>
    <button x="620" y="15" width="70" height="40" display="go" kind="Observer" forever="true" disableUntilTicks="true">go</button>
    <button x="700" y="15" width="150" height="40" display="reset guide model" kind="Observer" forever="false" disableUntilTicks="false">reset-guide-model</button>
    <slider x="535" y="65" width="220" height="50" display="grid-width" variable="grid-width" min="8.0" max="40.0" default="17.0" step="1.0" direction="Horizontal"></slider>
    <slider x="535" y="120" width="220" height="50" display="grid-height" variable="grid-height" min="8.0" max="40.0" default="13.0" step="1.0" direction="Horizontal"></slider>
    <slider x="535" y="175" width="220" height="50" display="num-evacuees" variable="num-evacuees" min="5.0" max="120.0" default="28.0" step="1.0" direction="Horizontal"></slider>
    <slider x="535" y="230" width="220" height="50" display="max-steps" variable="max-steps" min="20.0" max="300.0" default="50.0" step="1.0" direction="Horizontal"></slider>
    <slider x="535" y="285" width="220" height="50" display="guide-influence-radius" variable="guide-influence-radius" min="1.0" max="8.0" default="6.0" step="1.0" direction="Horizontal"></slider>
    <slider x="535" y="340" width="220" height="50" display="guide-follow-bias" variable="guide-follow-bias" min="0.0" max="1.0" default="0.9" step="0.05" direction="Horizontal"></slider>
    <slider x="535" y="395" width="220" height="50" display="random-move-bias" variable="random-move-bias" min="0.0" max="0.5" default="0.05" step="0.01" direction="Horizontal"></slider>
    <slider x="535" y="450" width="220" height="50" display="fire-spread-interval" variable="fire-spread-interval" min="1.0" max="10.0" default="2.0" step="1.0" direction="Horizontal"></slider>
    <slider x="535" y="505" width="220" height="50" display="fire-spread-probability" variable="fire-spread-probability" min="0.0" max="1.0" default="0.2" step="0.01" direction="Horizontal"></slider>
    <slider x="780" y="65" width="220" height="50" display="seed" variable="seed" min="0.0" max="10000.0" default="7.0" step="1.0" direction="Horizontal"></slider>
    <input x="780" y="120" width="220" height="45" variable="repo-root" type="string" multiline="false">auto</input>
    <input x="780" y="170" width="220" height="45" variable="python-executable" type="string" multiline="false">auto</input>
    <input x="780" y="220" width="220" height="45" variable="checkpoint-dir" type="string" multiline="false"></input>
    <input x="780" y="270" width="220" height="45" variable="guide-model" type="string" multiline="false">untrained</input>
    <switch x="780" y="320" width="190" height="40" display="use-python-policy?" variable="use-python-policy?" on="true"></switch>
    <slider x="1015" y="65" width="220" height="50" display="evacuation-reward" variable="evacuation-reward" min="0.0" max="10.0" default="3.0" step="0.1" direction="Horizontal"></slider>
    <slider x="1015" y="120" width="220" height="50" display="fire-reward-penalty" variable="fire-reward-penalty" min="-20.0" max="0.0" default="-8.0" step="0.1" direction="Horizontal"></slider>
    <slider x="1015" y="175" width="220" height="50" display="step-penalty" variable="step-penalty" min="-1.0" max="0.0" default="-0.03" step="0.01" direction="Horizontal"></slider>
    <slider x="1015" y="230" width="220" height="50" display="congestion-penalty" variable="congestion-penalty" min="-1.0" max="0.0" default="-0.01" step="0.01" direction="Horizontal"></slider>
    <slider x="1015" y="285" width="220" height="50" display="progress-reward" variable="progress-reward" min="0.0" max="1.0" default="0.05" step="0.01" direction="Horizontal"></slider>
    <slider x="1245" y="65" width="175" height="50" display="invalid-action-penalty" variable="invalid-action-penalty" min="-1.0" max="0.0" default="-0.05" step="0.01" direction="Horizontal"></slider>
    <slider x="1245" y="120" width="175" height="50" display="unresolved-penalty" variable="unresolved-penalty" min="-10.0" max="0.0" default="-2.0" step="0.1" direction="Horizontal"></slider>
    <monitor x="780" y="365" width="110" height="50" display="alive" precision="0" fontSize="11">alive-count</monitor>
    <monitor x="895" y="365" width="110" height="50" display="evacuated" precision="0" fontSize="11">evacuated-count</monitor>
    <monitor x="1010" y="365" width="110" height="50" display="dead" precision="0" fontSize="11">dead-count</monitor>
    <monitor x="1125" y="365" width="110" height="50" display="fire" precision="0" fontSize="11">fire-size</monitor>
    <monitor x="780" y="420" width="180" height="50" display="loaded guide" precision="0" fontSize="11">loaded-guide-model</monitor>
    <monitor x="970" y="420" width="110" height="50" display="last reward" precision="2" fontSize="11">last-reward</monitor>
    <monitor x="1090" y="420" width="145" height="50" display="total reward" precision="2" fontSize="11">total-reward</monitor>
    <plot x="780" y="500" width="365" height="200" display="Evacuation Outcomes" xAxis="tick" yAxis="count" xMin="0.0" xMax="100.0" yMin="0.0" yMax="30.0" autoPlotX="true" autoPlotY="true" legend="true">
      <setup></setup>
      <update></update>
      <pen display="alive" color="-955883" mode="0" interval="1.0" legend="true"><setup></setup><update></update></pen>
      <pen display="evacuated" color="-10899396" mode="0" interval="1.0" legend="true"><setup></setup><update></update></pen>
      <pen display="dead" color="-7500403" mode="0" interval="1.0" legend="true"><setup></setup><update></update></pen>
    </plot>
    <plot x="1155" y="500" width="270" height="200" display="Fire Size" xAxis="tick" yAxis="cells" xMin="0.0" xMax="100.0" yMin="0.0" yMax="80.0" autoPlotX="true" autoPlotY="true" legend="false">
      <setup></setup>
      <update></update>
      <pen display="fire" color="-2674135" mode="0" interval="1.0" legend="false"><setup></setup><update></update></pen>
    </plot>
  </widgets>
  <info><![CDATA[## WHAT IS IT?

This NetLogo 7 model mirrors the Python TenSnap evacuation DQN demo. NetLogo owns the grid, turtles, controls, monitors, and plots. The guide action can be chosen by the Python DQN policy through NetLogo's bundled `py` extension, or supplied externally by the Python training adapter.

## HOW TO USE IT

Click `setup`, then `go`. The `guide-model` input is a checkpoint file name from `examples/python_dqn/checkpoints`, or `untrained` for deterministic untrained DQN weights. Changing `guide-model` does not affect the active policy until `setup` or `reset-guide-model` is pressed.

If Python cannot import the repo automatically, set `repo-root` to the absolute path of this repository. `python-executable` defaults to `auto`, which tries common project, conda, and Homebrew Python paths before falling back to `python3`.

Each episode samples a fire immediately inside one of two doorway corridors. Civilians initially choose the nearest exit. The guide's left/right action broadcasts a preferred exit to nearby civilians, so a useful policy must identify the blocked side and redirect the crowd. The model stops when everyone is resolved or `max-steps` is reached.

## PYTHON BRIDGE

With `use-python-policy?` on, the model initializes Python once with `py:setup`, imports `python_dqn.netlogo_policy`, passes a compact 16-value state vector using `py:set`, and receives the guide action from `py:runresult`. With it off, Python can set `training-action` before each `go` call.
]]></info>
  <experiments>
    <experiment name="smoke" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="5">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>alive-count</metric>
        <metric>evacuated-count</metric>
        <metric>dead-count</metric>
        <metric>fire-size</metric>
        <metric>count evacuees</metric>
        <metric>policy-loaded?</metric>
      </metrics>
      <subExperiments>
        <subExperiment>
        <enumeratedValueSet variable="grid-width"><value value="17"></value></enumeratedValueSet>
        <enumeratedValueSet variable="grid-height"><value value="13"></value></enumeratedValueSet>
        <enumeratedValueSet variable="num-evacuees"><value value="28"></value></enumeratedValueSet>
        <enumeratedValueSet variable="max-steps"><value value="50"></value></enumeratedValueSet>
        <enumeratedValueSet variable="guide-influence-radius"><value value="6"></value></enumeratedValueSet>
        <enumeratedValueSet variable="guide-follow-bias"><value value="0.9"></value></enumeratedValueSet>
        <enumeratedValueSet variable="random-move-bias"><value value="0.05"></value></enumeratedValueSet>
        <enumeratedValueSet variable="fire-spread-interval"><value value="2"></value></enumeratedValueSet>
        <enumeratedValueSet variable="fire-spread-probability"><value value="0.2"></value></enumeratedValueSet>
        <enumeratedValueSet variable="seed"><value value="7"></value></enumeratedValueSet>
        <enumeratedValueSet variable="repo-root"><value value="&quot;auto&quot;"></value></enumeratedValueSet>
        <enumeratedValueSet variable="python-executable"><value value="&quot;auto&quot;"></value></enumeratedValueSet>
        <enumeratedValueSet variable="checkpoint-dir"><value value="&quot;&quot;"></value></enumeratedValueSet>
        <enumeratedValueSet variable="guide-model"><value value="&quot;untrained&quot;"></value></enumeratedValueSet>
        <enumeratedValueSet variable="use-python-policy?"><value value="false"></value></enumeratedValueSet>
        <enumeratedValueSet variable="evacuation-reward"><value value="3"></value></enumeratedValueSet>
        <enumeratedValueSet variable="fire-reward-penalty"><value value="-8"></value></enumeratedValueSet>
        <enumeratedValueSet variable="step-penalty"><value value="-0.03"></value></enumeratedValueSet>
        <enumeratedValueSet variable="congestion-penalty"><value value="-0.01"></value></enumeratedValueSet>
        <enumeratedValueSet variable="progress-reward"><value value="0.05"></value></enumeratedValueSet>
        <enumeratedValueSet variable="invalid-action-penalty"><value value="-0.05"></value></enumeratedValueSet>
        <enumeratedValueSet variable="unresolved-penalty"><value value="-2"></value></enumeratedValueSet>
        </subExperiment>
      </subExperiments>
    </experiment>
  </experiments>
</model>
