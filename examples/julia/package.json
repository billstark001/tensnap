{
  "name": "@tensnap/examples-julia",
  "version": "0.3.4",
  "private": true,
  "description": "Runnable Julia examples for TenSnap.",
  "type": "module",
  "scripts": {
    "instantiate": "julia --startup-file=no --project=. run_example.jl --instantiate-only",
    "demo:el-farol": "julia --startup-file=no --project=. run_example.jl el-farol",
    "demo:schelling": "julia --startup-file=no --project=. run_example.jl schelling",
    "demo:schelling:makie": "julia --startup-file=no --project=. run_example.jl schelling:makie",
    "standalone:schelling": "julia --startup-file=no --project=. schelling_standalone.jl",
    "build": "pnpm run instantiate",
    "test": "julia --startup-file=no --project=. test_examples.jl && julia --startup-file=no --project=. test_package.jl",
    "lint": "jlfmt --indent=2 --check .",
    "format": "jlfmt --indent=2 --inplace ."
  }
}
