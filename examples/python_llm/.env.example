# Replace the key locally and pass this file with --env-file.
# serve starts with rule policy by default; credentials enable selecting llm.
# Select llm in TenSnap, then Reset and run, or start with --policy llm.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=replace-locally
LLM_MAX_CALLS=32
LLM_TIMEOUT=45
# Each wire option accepts omit to remove the field, never send JSON null.
# Existing defaults below retain the original request behavior.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=128
# Any nonempty string is sent as response_format.type; omit removes the object.
# text/omit still require the model to return a valid JSON decision.
LLM_RESPONSE_FORMAT=json_object
# Only false/omit are supported; this client does not parse streaming responses.
LLM_STREAM=false

# Additional wire options default to omission.
# To use max_completion_tokens instead, also set LLM_MAX_TOKENS=omit.
LLM_MAX_COMPLETION_TOKENS=omit
LLM_TOP_P=omit
LLM_PRESENCE_PENALTY=omit
LLM_FREQUENCY_PENALTY=omit

# Optional provider-specific JSON, matching these examples' DeepSeek default.
# For another provider, use {} unless it supports these extra fields.
# This does not remove standard fields such as temperature or max_tokens.
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Minimal gateway/local-model configuration: replace the values above with
# LLM_TEMPERATURE=omit
# LLM_MAX_TOKENS=omit
# LLM_RESPONSE_FORMAT=omit
# LLM_EXTRA_BODY={}
# If the gateway also rejects stream, set LLM_STREAM=omit.
# With both token-limit fields omitted, no output token limit is sent.
# Precedence: explicit CLI options > environment variables > this file > defaults.
