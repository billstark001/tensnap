LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=replace-locally
LLM_MAX_CALLS=32
LLM_MAX_TOKENS=128
LLM_TIMEOUT=45
LLM_TEMPERATURE=0.7
# Optional provider-specific JSON. DeepSeek defaults to thinking enabled;
# these examples use short decisions, so disable thinking explicitly.
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
