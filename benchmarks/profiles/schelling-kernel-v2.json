{
  "schemaVersion": 2,
  "id": "schelling-kernel-v2",
  "description": "Distributional Schelling kernel case study at similarity threshold 0.8. Each system executes exactly 500 steps of the v1 steady-state specification in a fresh process; startup, JIT and model time remain separate measurements.",
  "suites": ["node"],
  "repetitions": 15,
  "warmupActions": 0,
  "measuredActions": 1,
  "encodings": ["json"],
  "validation": ["error"],
  "requireCleanGit": true,
  "processIsolation": "required",
  "randomizedBlocks": true,
  "comparisons": [
    {
      "id": "schelling-kernel",
      "metric": "cycle",
      "baseline": "mesa",
      "treatments": ["go", "julia"]
    }
  ],
  "workloads": [
    {
      "id": "mesa",
      "system": "Mesa (Python)",
      "primaryMetric": "cycle",
      "featureLevel": "kernel-only",
      "dimensions": {
        "grid": "50x50",
        "steps": 500,
        "similarityThreshold": 0.8,
        "instrumentation": "none"
      },
      "module": "../schelling/external-process.ts",
      "config": {
        "executable": "python3",
        "args": [
          "kernel.py",
          "--width",
          "50",
          "--height",
          "50",
          "--density",
          "0.8",
          "--balance",
          "0.5",
          "--thresholds",
          "0.80",
          "--warmup-steps",
          "25",
          "--steps",
          "500",
          "--seeds",
          "1",
          "--seed",
          "{seed}",
          "--mode",
          "steady",
          "--instrumentation",
          "none",
          "--benchmark-json"
        ],
        "cwd": "benchmarks/schelling/v1/subjects/mesa",
        "timeoutMs": 120000,
        "environmentLocks": {
          "benchmarks/environments/python-mesa.requirements.lock": "8b819128d634ec01dcffceba0ceaca6dcbe9641f49753ea38e5e36837f9f105a"
        },
        "seed": 20260718,
        "expected": {
          "mode": "steady",
          "actionCount": 1,
          "metrics": { "totalTicks": { "min": 500, "max": 500 }, "elapsedMs": { "min": 0 } },
          "state": {
            "instrumentation": "none",
            "actualSteps": { "min": 500, "max": 500 },
            "satisfiedPct": { "min": 0, "max": 1 },
            "segregationIndex": { "min": 0, "max": 1 }
          }
        }
      }
    },
    {
      "id": "go",
      "system": "Go reference implementation",
      "primaryMetric": "cycle",
      "featureLevel": "kernel-only",
      "dimensions": {
        "grid": "50x50",
        "steps": 500,
        "similarityThreshold": 0.8,
        "instrumentation": "none"
      },
      "module": "../schelling/external-process.ts",
      "config": {
        "executable": "go",
        "args": [
          "run",
          "./kernel",
          "--width",
          "50",
          "--height",
          "50",
          "--density",
          "0.8",
          "--balance",
          "0.5",
          "--thresholds",
          "0.80",
          "--warmup-steps",
          "25",
          "--steps",
          "500",
          "--seeds",
          "1",
          "--seed",
          "{seed}",
          "--mode",
          "steady",
          "--benchmark-json"
        ],
        "cwd": "benchmarks/schelling/v1/subjects/go",
        "timeoutMs": 120000,
        "environmentLocks": {
          "benchmarks/schelling/v1/subjects/go/go.mod": "38fd30b29f6e778f9d8abea130f67fd36f038649287bb953b82da72d72031e29",
          "benchmarks/schelling/v1/subjects/go/go.sum": "5d9e0a9753367c2e11a8e669600d05e2b8af00b96a358f112510e1a49b7e1b63"
        },
        "seed": 20260718,
        "expected": {
          "mode": "steady",
          "actionCount": 1,
          "metrics": { "totalTicks": { "min": 500, "max": 500 }, "elapsedMs": { "min": 0 } },
          "state": {
            "actualSteps": { "min": 500, "max": 500 },
            "satisfiedPct": { "min": 0, "max": 1 },
            "segregationIndex": { "min": 0, "max": 1 }
          }
        }
      }
    },
