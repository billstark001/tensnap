{
  "schemaVersion": 2,
  "id": "evaluation-2026-schelling-kernel-v2",
  "description": "October 2026 rerun. Distributional Schelling kernel case study at similarity threshold 0.8. Each system executes exactly 500 steps of the v1 steady-state specification in a fresh process; startup, JIT and model time remain separate measurements.",
  "suites": ["node"],
  "repetitions": 15,
  "warmupActions": 0,
  "measuredActions": 1,
  "encodings": ["json"],
  "validation": ["error"],
  "requireCleanGit": true,
  "processIsolation": "required",
  "randomizedBlocks": true,
  "comparisons": [
    {
      "id": "schelling-kernel",
      "metric": "cycle",
      "baseline": "mesa",
      "treatments": ["go", "julia"]
    }
  ],
  "workloads": [
    {
      "id": "mesa",
      "system": "Mesa (Python)",
      "primaryMetric": "cycle",
      "featureLevel": "kernel-only",
      "dimensions": {
        "grid": "50x50",
        "steps": 500,
        "similarityThreshold": 0.8,
        "instrumentation": "none"
      },
      "module": "../schelling/external-process.ts",
      "config": {
        "executable": "python3",
        "args": [
          "kernel.py",
          "--width",
          "50",
          "--height",
          "50",
          "--density",
          "0.8",
          "--balance",
          "0.5",
          "--thresholds",
          "0.80",
          "--warmup-steps",
          "25",
          "--steps",
          "500",
          "--seeds",
          "1",
          "--seed",
          "{seed}",
          "--mode",
          "steady",
          "--instrumentation",
          "none",
          "--benchmark-json"
        ],
        "cwd": "benchmarks/schelling/v1/subjects/mesa",
        "timeoutMs": 120000,
        "environmentLocks": {
          "benchmarks/environments/python-mesa.requirements.lock": "8b819128d634ec01dcffceba0ceaca6dcbe9641f49753ea38e5e36837f9f105a",
          "benchmarks/environments/python-evaluation.requirements.lock": "2754b87ff29070f5e41474cce9cee9dccc8ca91e06604d31116e74169f79f010"
        },
        "seed": 20260718,
        "expected": {
          "mode": "steady",
          "actionCount": 1,
          "metrics": {
            "totalTicks": {
              "min": 500,
              "max": 500
            },
            "elapsedMs": {
              "min": 0
            }
          },
          "state": {
            "instrumentation": "none",
            "actualSteps": {
              "min": 500,
              "max": 500
            },
            "satisfiedPct": {
              "min": 0,
              "max": 1
            },
            "segregationIndex": {
              "min": 0,
              "max": 1
            }
          }
        }
      }
    },
