{
  "schemaVersion": 2,
  "id": "schelling-netlogo-render-v1",
  "description": "NetLogo 7.0.4 descriptive rendering profile. Every action advances the Schelling model, recolors patches, forces a headless export-view PNG, and validates every rendered patch against NetLogo state. The metric includes PNG encoding and file I/O and is not paired with browser rAF latency.",
  "suites": ["node"],
  "repetitions": 15,
  "warmupActions": 5,
  "measuredActions": 20,
  "encodings": ["json"],
  "validation": ["error"],
  "requireCleanGit": true,
  "processIsolation": "required",
  "randomizedBlocks": false,
  "workloads": [
    {
      "id": "netlogo-v7-forced-view",
      "system": "NetLogo 7.0.4 headless export-view",
      "primaryMetric": "actionToPngMs",
      "featureLevel": "native-view-forced-png-export",
      "dimensions": {
        "grid": "50x50",
        "density": 0.8,
        "balance": 0.5,
        "threshold": 0.7,
        "rendering": "built-in export-view after every action; PNG encoding and file I/O included"
      },
      "module": "../schelling/netlogo-render.ts",
      "config": {
        "executable": "python3",
        "args": [
          "render.py",
          "--model-path", "{repositoryRoot}/examples/python_mesa/schelling.nlogox",
          "--density", "0.8",
          "--balance", "0.5",
          "--threshold", "0.7",
          "--seed", "{seed}",
          "--warmup-actions", "{warmupActions}",
          "--measured-actions", "{measuredActions}"
        ],
        "cwd": "benchmarks/schelling/v1/subjects/netlogo",
        "timeoutMs": 180000,
        "environmentLocks": {
          "benchmarks/environments/python-netlogo7-render.requirements.lock": "f95974adf0dffaa44700a7db48cff47b3346607d025d3078cb89e5e727d5fa23",
          "examples/python_mesa/schelling.nlogox": "371526d99d12c8cd798b7a996870031e38ae08760db43c81e73a858be55d02ec"
        },
        "seed": 20260718,
        "netlogoVersion": "7.0.4"
      }
    }
  ]
}
