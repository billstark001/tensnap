{
  "schemaVersion": 2,
  "id": "evaluation-2026-schelling-ui-go-v2",
  "description": "October 2026 rerun. Go/Schelling UI case study at similarity threshold 0.8 and final tick 500. The headless condition is the same model kernel baseline; the TenSnap condition measures a Step action through completion in the production Web host.",
  "suites": ["node", "browser"],
  "repetitions": 15,
  "warmupActions": 5,
  "measuredActions": 495,
  "encodings": ["json"],
  "validation": ["error"],
  "requireCleanGit": true,
  "processIsolation": "required",
  "randomizedBlocks": true,
  "workloads": [
    {
      "id": "go-headless",
      "system": "Go headless (kernel baseline)",
      "primaryMetric": "cycle",
      "featureLevel": "kernel-only",
      "dimensions": {
        "grid": "50x50",
        "steps": 500,
        "similarityThreshold": 0.8
      },
      "warmupActions": 0,
      "measuredActions": 1,
      "module": "../schelling/external-process.ts",
      "config": {
        "executable": "go",
        "args": [
          "run",
          "-mod=readonly",
          "-modfile=../../../../evaluation/environments/go/go.mod",
          "./kernel",
          "--width",
          "50",
          "--height",
          "50",
          "--density",
          "0.8",
          "--balance",
          "0.5",
          "--thresholds",
          "0.80",
          "--warmup-steps",
          "25",
          "--steps",
          "500",
          "--seeds",
          "1",
          "--seed",
          "{seed}",
          "--mode",
          "steady",
          "--benchmark-json"
        ],
        "cwd": "benchmarks/schelling/v1/subjects/go",
        "timeoutMs": 120000,
        "environmentLocks": {
          "benchmarks/evaluation/environments/go/go.mod": "38fd30b29f6e778f9d8abea130f67fd36f038649287bb953b82da72d72031e29",
          "benchmarks/evaluation/environments/go/go.sum": "5d9e0a9753367c2e11a8e669600d05e2b8af00b96a358f112510e1a49b7e1b63"
        },
        "seed": 20260718,
        "expected": {
          "mode": "steady",
          "actionCount": 1,
          "metrics": {
            "totalTicks": {
              "min": 500,
              "max": 500
            },
            "elapsedMs": {
              "min": 0
            }
          },
          "state": {
            "actualSteps": {
              "min": 500,
              "max": 500
            },
            "satisfiedPct": {
              "min": 0,
              "max": 1
            },
            "segregationIndex": {
              "min": 0,
              "max": 1
            }
          }
        }
      }
    },
    {
      "id": "go-tensnap-web-raf",
      "system": "Go + TenSnap binding + Web host (rAF frame latency)",
      "primaryMetric": "actionToRenderCompleteMs",
      "featureLevel": "agents+three-statistics",
      "dimensions": {
        "grid": "50x50",
        "finalTick": 500,
        "similarityThreshold": 0.8,
        "warmupActions": 5,
        "measuredActions": 495,
        "renderTrigger": "requestAnimationFrame"
      },
      "stateEquivalenceGroup": "go-ui-v2",
      "browserOptions": {
        "renderTriggerMode": "requestAnimationFrame"
      },
      "module": "../schelling/tensnap-web-external.ts",
      "config": {
        "executable": "go",
        "args": [
          "run",
          "-mod=readonly",
          "-modfile=../../../../evaluation/environments/go/go.mod",
          "./tensnap",
          "--width",
          "50",
          "--height",
          "50",
          "--density",
          "0.8",
          "--balance",
          "0.5",
          "--threshold",
          "0.80",
          "--seed",
          "{seed}",
          "--port",
          "{port}"
        ],
        "cwd": "benchmarks/schelling/v1/subjects/go",
        "endpoint": "ws://127.0.0.1:{port}",
        "encoding": "json",
        "width": 900,
        "height": 700,
        "timeoutMs": 120000,
        "environmentLocks": {
          "benchmarks/evaluation/environments/go/go.mod": "38fd30b29f6e778f9d8abea130f67fd36f038649287bb953b82da72d72031e29",
          "benchmarks/evaluation/environments/go/go.sum": "5d9e0a9753367c2e11a8e669600d05e2b8af00b96a358f112510e1a49b7e1b63"
        },
        "seed": 20260718
      }
    },
    {
      "id": "go-tensnap-web-timeout",
      "system": "Go + TenSnap binding + Web host (timeout throughput)",
      "primaryMetric": "actionToRunCompletionMs",
      "featureLevel": "agents+three-statistics",
      "dimensions": {
        "grid": "50x50",
        "finalTick": 500,
        "similarityThreshold": 0.8,
        "warmupActions": 5,
        "measuredActions": 495,
        "renderTrigger": "setTimeout"
      },
      "stateEquivalenceGroup": "go-ui-v2",
      "browserOptions": {
        "renderTriggerMode": "setTimeout"
      },
      "module": "../schelling/tensnap-web-external.ts",
      "config": {
        "executable": "go",
        "args": [
          "run",
          "-mod=readonly",
          "-modfile=../../../../evaluation/environments/go/go.mod",
          "./tensnap",
          "--width",
          "50",
          "--height",
          "50",
          "--density",
          "0.8",
          "--balance",
          "0.5",
          "--threshold",
          "0.80",
          "--seed",
          "{seed}",
          "--port",
          "{port}"
        ],
        "cwd": "benchmarks/schelling/v1/subjects/go",
        "endpoint": "ws://127.0.0.1:{port}",
        "encoding": "json",
        "width": 900,
        "height": 700,
        "timeoutMs": 120000,
        "environmentLocks": {
          "benchmarks/evaluation/environments/go/go.mod": "38fd30b29f6e778f9d8abea130f67fd36f038649287bb953b82da72d72031e29",
          "benchmarks/evaluation/environments/go/go.sum": "5d9e0a9753367c2e11a8e669600d05e2b8af00b96a358f112510e1a49b7e1b63"
        },
        "seed": 20260718
      }
    }
  ],
  "comparisons": []
}
