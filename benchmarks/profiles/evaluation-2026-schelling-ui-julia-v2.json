{
  "schemaVersion": 2,
  "id": "evaluation-2026-schelling-ui-julia-v2",
  "description": "October 2026 rerun. Agents.jl/Schelling UI case study at similarity threshold 0.8 and final tick 500. WGLMakie and TenSnap expose the same agents-only state and use the same action-to-render-complete boundary; screenshots are accepted only after the page is visually stable.",
  "suites": ["node", "browser"],
  "repetitions": 15,
  "warmupActions": 5,
  "measuredActions": 495,
  "encodings": ["msgpack"],
  "validation": ["error"],
  "requireCleanGit": true,
  "processIsolation": "required",
  "randomizedBlocks": true,
  "workloads": [
    {
      "id": "agents-headless",
      "system": "Agents.jl headless (kernel baseline)",
      "primaryMetric": "cycle",
      "featureLevel": "kernel-only",
      "dimensions": {
        "grid": "50x50",
        "steps": 500,
        "similarityThreshold": 0.8
      },
      "warmupActions": 0,
      "measuredActions": 1,
      "module": "../schelling/external-process.ts",
      "config": {
        "executable": "julia",
        "args": [
          "--project=benchmarks/evaluation/environments/julia",
          "benchmarks/schelling/v1/subjects/julia/kernel.jl",
          "--width=50",
          "--height=50",
          "--density=0.8",
          "--balance=0.5",
          "--thresholds=0.80",
          "--warmup-steps=25",
          "--steps=500",
          "--seeds=1",
          "--seed={seed}",
          "--mode=steady",
          "--benchmark-json=true"
        ],
        "cwd": ".",
        "timeoutMs": 180000,
        "environmentLocks": {
          "benchmarks/evaluation/environments/julia/Project.toml": "533863cbb5286c130975583ccc6358277970b6c79686ce27857ef997251e7fac",
          "benchmarks/evaluation/environments/julia/Manifest.toml": "459cd6f19eca60a590967d001a0cd9bff7d4ddd80beaea8c54616418490b1dda"
        },
        "seed": 20260718,
        "expected": {
          "mode": "steady",
          "actionCount": 1,
          "metrics": {
            "totalTicks": {
              "min": 500,
              "max": 500
            }
          },
          "state": {
            "instrumentation": "none",
            "actualSteps": {
              "min": 500,
              "max": 500
            }
          }
        }
      }
    },
    {
      "id": "agents-wglmakie",
      "system": "Agents.jl + WGLMakie (agents-only)",
      "primaryMetric": "actionToRenderCompleteMs",
      "featureLevel": "agents-only",
      "dimensions": {
        "grid": "50x50",
        "finalTick": 500,
        "similarityThreshold": 0.8,
        "warmupActions": 5,
        "measuredActions": 495,
        "renderTrigger": "requestAnimationFrame"
      },
      "stateEquivalenceGroup": "julia-ui-v2",
      "module": "../schelling/external-browser.ts",
      "config": {
        "executable": "julia",
        "args": [
          "--project=benchmarks/evaluation/environments/julia",
          "benchmarks/schelling/v1/subjects/julia/wglmakie.jl"
        ],
        "cwd": ".",
        "env": {
          "BONITO_HOST": "127.0.0.1",
          "BONITO_PORT": "{port}",
          "BONITO_TICKS_PER_SECOND": "60",
          "TENSNAP_SCHELLING_WIDTH": "50",
          "TENSNAP_SCHELLING_HEIGHT": "50",
          "TENSNAP_SCHELLING_DENSITY": "0.8",
          "TENSNAP_SCHELLING_BALANCE": "0.5",
          "TENSNAP_SCHELLING_THRESHOLD": "0.80",
          "TENSNAP_SCHELLING_SEED": "{seed}"
        },
        "timeoutMs": 180000,
        "environmentLocks": {
          "benchmarks/evaluation/environments/julia/Project.toml": "533863cbb5286c130975583ccc6358277970b6c79686ce27857ef997251e7fac",
          "benchmarks/evaluation/environments/julia/Manifest.toml": "459cd6f19eca60a590967d001a0cd9bff7d4ddd80beaea8c54616418490b1dda"
        },
        "url": "http://127.0.0.1:{port}",
        "readySelector": "canvas",
        "actionSelector": "button:has-text('Step')",
        "actionTimeoutMs": 60000,
        "checkpointActions": [0, 5, 500],
        "seed": 20260718
      }
    },
    {
      "id": "agents-tensnap-web-raf",
      "system": "Agents.jl + TenSnap binding + Web host (rAF frame latency)",
      "primaryMetric": "actionToRenderCompleteMs",
      "featureLevel": "agents-only",
      "dimensions": {
        "grid": "50x50",
        "finalTick": 500,
        "similarityThreshold": 0.8,
        "warmupActions": 5,
        "measuredActions": 495,
        "renderTrigger": "requestAnimationFrame"
      },
      "stateEquivalenceGroup": "julia-ui-v2",
      "browserOptions": {
        "renderTriggerMode": "requestAnimationFrame"
      },
      "module": "../schelling/tensnap-web-external.ts",
      "config": {
        "executable": "julia",
        "args": [
          "--project=benchmarks/evaluation/environments/julia",
          "benchmarks/schelling/v1/subjects/julia/tensnap.jl"
        ],
        "cwd": ".",
        "env": {
          "TENSNAP_SERVER_PORT": "{port}",
          "TENSNAP_SCHELLING_WIDTH": "50",
          "TENSNAP_SCHELLING_HEIGHT": "50",
          "TENSNAP_SCHELLING_DENSITY": "0.8",
          "TENSNAP_SCHELLING_BALANCE": "0.5",
          "TENSNAP_SCHELLING_THRESHOLD": "0.80",
          "TENSNAP_SCHELLING_SEED": "{seed}"
        },
        "endpoint": "ws://127.0.0.1:{port}",
        "encoding": "msgpack",
        "width": 900,
        "height": 700,
        "timeoutMs": 180000,
        "environmentLocks": {
          "benchmarks/evaluation/environments/julia/Project.toml": "533863cbb5286c130975583ccc6358277970b6c79686ce27857ef997251e7fac",
          "benchmarks/evaluation/environments/julia/Manifest.toml": "459cd6f19eca60a590967d001a0cd9bff7d4ddd80beaea8c54616418490b1dda"
        },
        "seed": 20260718
      }
    },
    {
      "id": "agents-tensnap-web-timeout",
      "system": "Agents.jl + TenSnap binding + Web host (timeout throughput)",
      "primaryMetric": "actionToRunCompletionMs",
      "featureLevel": "agents-only",
      "dimensions": {
        "grid": "50x50",
        "finalTick": 500,
        "similarityThreshold": 0.8,
        "warmupActions": 5,
        "measuredActions": 495,
        "renderTrigger": "setTimeout"
      },
      "stateEquivalenceGroup": "julia-ui-v2",
      "browserOptions": {
        "renderTriggerMode": "setTimeout"
      },
      "module": "../schelling/tensnap-web-external.ts",
      "config": {
        "executable": "julia",
        "args": [
          "--project=benchmarks/evaluation/environments/julia",
          "benchmarks/schelling/v1/subjects/julia/tensnap.jl"
        ],
        "cwd": ".",
        "env": {
          "TENSNAP_SERVER_PORT": "{port}",
          "TENSNAP_SCHELLING_WIDTH": "50",
          "TENSNAP_SCHELLING_HEIGHT": "50",
          "TENSNAP_SCHELLING_DENSITY": "0.8",
          "TENSNAP_SCHELLING_BALANCE": "0.5",
          "TENSNAP_SCHELLING_THRESHOLD": "0.80",
          "TENSNAP_SCHELLING_SEED": "{seed}"
        },
        "endpoint": "ws://127.0.0.1:{port}",
        "encoding": "msgpack",
        "width": 900,
        "height": 700,
        "timeoutMs": 180000,
        "environmentLocks": {
          "benchmarks/evaluation/environments/julia/Project.toml": "533863cbb5286c130975583ccc6358277970b6c79686ce27857ef997251e7fac",
          "benchmarks/evaluation/environments/julia/Manifest.toml": "459cd6f19eca60a590967d001a0cd9bff7d4ddd80beaea8c54616418490b1dda"
        },
        "seed": 20260718
      }
    }
  ],
  "comparisons": [
    {
      "id": "julia-ui-render-complete",
      "metric": "actionToRenderCompleteMs",
      "baseline": "agents-wglmakie",
      "treatments": ["agents-tensnap-web-raf"]
    }
  ]
}
