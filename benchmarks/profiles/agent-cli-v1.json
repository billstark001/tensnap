{
  "schemaVersion": 2,
  "id": "agent-cli-v1",
  "description": "Agent CLI v1: Schelling control and bounded queries, deterministic random-walk archive/full-history/rolling collection.",
  "suites": [
    "node"
  ],
  "repetitions": 15,
  "warmupActions": 0,
  "measuredActions": 1,
  "encodings": [
    "json"
  ],
  "validation": [
    "error"
  ],
  "requireCleanGit": true,
  "processIsolation": "required",
  "randomizedBlocks": true,
  "comparisons": [
    {
      "id": "schelling-control",
      "baseline": "control-http-batch",
      "treatments": [
        "control-cli-batch",
        "control-cli-single"
      ],
      "metric": "cycle"
    }
  ],
  "workloads": [
