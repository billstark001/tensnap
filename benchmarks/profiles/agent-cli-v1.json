        "grid": "50x50",
        "steps": 495,
        "prepSteps": 5
      },
      "module": "../agent/v1/benchmark.ts",
      "config": {
        "case": "control",
        "control": "cli-single",
        "gridSize": 50,
        "steps": 495,
        "prepSteps": 5,
