{
  "schemaVersion": 2,
  "id": "agent-cli-v1-smoke",
  "description": "Diagnostic smoke for agent CLI control, bounded queries and long-history collection; not publication measurements.",
  "suites": [
    "node"
  ],
  "repetitions": 2,
  "warmupActions": 0,
  "measuredActions": 1,
  "encodings": [
    "json"
