{
  "schemaVersion": 2,
  "id": "schelling-ui-julia-v1",
  "description": "Agents.jl/Schelling UI case study. The browser condition measures a Step click through the first changed WGLMakie frame and stores visual checkpoint hashes.",
  "suites": ["node", "browser"],
  "repetitions": 15,
  "warmupActions": 5,
  "measuredActions": 20,
  "encodings": ["json"],
  "validation": ["error"],
  "requireCleanGit": true,
  "processIsolation": "required",
  "randomizedBlocks": true,
  "workloads": [
    {
      "id": "agents-headless",
      "system": "Agents.jl headless (kernel baseline)",
      "warmupActions": 0,
      "measuredActions": 1,
      "module": "../schelling/external-process.ts",
      "config": {
        "executable": "julia",
        "args": ["--project=.", "schelling_standalone.jl", "--width=50", "--height=50", "--density=0.8", "--balance=0.5", "--thresholds=0.70", "--warmup-steps=25", "--steps=200", "--seeds=1", "--seed={seed}", "--mode=steady", "--benchmark-json=true"],
        "cwd": "examples/julia",
        "timeoutMs": 180000,
        "environmentLocks": { "examples/julia/Manifest.toml": "8b3c49dc6a3c00daec28294b54af1c917b30bfbd6569969ebf14d66b4779689b" },
        "seed": 20260718,
        "expected": { "mode": "steady", "actionCount": 1, "metrics": { "totalTicks": { "min": 200, "max": 200 } }, "state": { "instrumentation": "none", "actualSteps": { "min": 200, "max": 200 } } }
      }
    },
    {
      "id": "agents-wglmakie",
      "system": "Agents.jl + WGLMakie (agents-only)",
      "module": "../schelling/external-browser.ts",
      "config": {
        "executable": "julia",
        "args": ["--project=.", "schelling_viz_makie.jl"],
        "cwd": "examples/julia",
        "env": { "BONITO_HOST": "127.0.0.1", "BONITO_PORT": "8768", "TENSNAP_SCHELLING_SEED": "{seed}" },
        "timeoutMs": 180000,
        "environmentLocks": { "examples/julia/Manifest.toml": "8b3c49dc6a3c00daec28294b54af1c917b30bfbd6569969ebf14d66b4779689b" },
        "url": "http://127.0.0.1:8768",
        "readySelector": "button:has-text('Step')",
        "actionSelector": "button:has-text('Step')",
        "actionTimeoutMs": 60000,
        "checkpointActions": [0, 5, 25],
        "seed": 20260718
      }
    },
    {
      "id": "agents-tensnap-web",
      "system": "Agents.jl + TenSnap binding + Web host (agents + charts)",
      "module": "../schelling/tensnap-web-external.ts",
      "config": {
        "executable": "julia",
        "args": ["--project=.", "schelling_viz.jl"],
        "cwd": "examples/julia",
        "env": { "TENSNAP_SERVER_PORT": "8765", "TENSNAP_SCHELLING_SEED": "{seed}" },
        "endpoint": "ws://127.0.0.1:8765",
        "encoding": "msgpack",
        "width": 900,
        "height": 700,
        "timeoutMs": 180000,
        "environmentLocks": { "examples/julia/Manifest.toml": "8b3c49dc6a3c00daec28294b54af1c917b30bfbd6569969ebf14d66b4779689b" },
        "seed": 20260718
      }
    }
  ]
}
