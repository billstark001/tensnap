{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@tensnap/web": ["./index.ts"],
      "@tensnap/web/*": ["./src/*"],
      "@tensnap/core": ["../core/src/index.ts"],
      "@tensnap/core/*": ["../core/src/*"],
      "@tensnap/web-adapter": ["../web-adapter/src/index.ts"],
      "@tensnap/web-adapter/*": ["../web-adapter/src/*"],
      "@tensnap/web-adapter/file-system": ["../web-adapter/src/file-system/index.ts"],
      "@tensnap/web-adapter/adapters": ["../web-adapter/src/adapters/index.ts"],
      "@tensnap/web-adapter/adapters/*": ["../web-adapter/src/adapters/*"]
    }
  },
  "include": ["src", "adapters.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}