{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "tensnap-web-utils": ["../tensnap-web-utils/src/index.ts"],
      "tensnap-web-utils/*": ["../tensnap-web-utils/src/*"],
      "tensnap-web-utils/file-system": ["../tensnap-web-utils/src/file-system/index.ts"],
      "tensnap-web-utils/adapters": ["../tensnap-web-utils/src/adapters/index.ts"],
      "tensnap-web-utils/adapters/*": ["../tensnap-web-utils/src/adapters/*"]
    }
  },
  "include": ["src", "adapters.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}