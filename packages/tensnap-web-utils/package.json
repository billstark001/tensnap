{
  "name": "tensnap-web-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web utilities for TenSnap including filesystem UI and development tools",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./file-system": "./src/file-system/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./adapters/memory": "./src/adapters/memory-adapter.ts",
    "./adapters/indexeddb": "./src/adapters/indexeddb-adapter.ts"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --maxWorkers=1",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --maxWorkers=1",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tensnap-web": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vanilla-extract/css": "^1.17.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
