{
  "name": "tensnap-web-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web utilities for TenSnap including filesystem UI and development tools",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./file-system": "./src/file-system/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./adapters/memory": "./src/adapters/memory-adapter.ts",
    "./adapters/indexeddb": "./src/adapters/indexeddb-adapter.ts",
    "./fake-models": "./src/fake-models/index.ts"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --maxWorkers=1",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --maxWorkers=1",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "clean": "rm -rf dist node_modules",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile"
  },
  "dependencies": {
    "@lingui/cli": "^5.9.1",
    "@lingui/core": "^5.9.1",
    "@lingui/macro": "^5.9.1",
    "@lingui/react": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tensnap-web": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vanilla-extract/css": "^1.18.0",
    "fake-indexeddb": "^6.2.5",
    "identity-obj-proxy": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
