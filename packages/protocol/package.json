{
  "name": "@tensnap/protocol",
  "version": "0.2.1",
  "type": "module",
  "description": "Canonical TenSnap renderer/simulator protocol payload types, schemas, and codecs.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./asset": "./src/asset.ts",
    "./binary": "./src/binary.ts",
    "./chart": "./src/chart.ts",
    "./codec": "./src/codec.ts",
    "./controls": "./src/controls.ts",
    "./layers": "./src/layers.ts",
    "./schemas": "./src/schemas.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "export:protocol": "node ./scripts/export-protocol.mjs",
    "export:types": "node ./scripts/gen-zod-docs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run typecheck",
    "format": "echo 'No formatter configured'",
    "clean": "rm -rf dist node_modules"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./asset": {
        "types": "./dist/asset.d.ts",
        "import": "./dist/asset.js"
      },
      "./binary": {
        "types": "./dist/binary.d.ts",
        "import": "./dist/binary.js"
      },
      "./chart": {
        "types": "./dist/chart.d.ts",
        "import": "./dist/chart.js"
      },
      "./codec": {
        "types": "./dist/codec.d.ts",
        "import": "./dist/codec.js"
      },
      "./controls": {
        "types": "./dist/controls.d.ts",
        "import": "./dist/controls.js"
      },
      "./layers": {
        "types": "./dist/layers.d.ts",
        "import": "./dist/layers.js"
      },
      "./schemas": {
        "types": "./dist/schemas.d.ts",
        "import": "./dist/schemas.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.js"
      }
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod-to-ts": "^2.1.0"
  },
  "keywords": [
    "tensnap",
    "protocol",
    "simulator",
    "renderer",
    "messagepack"
  ]
}
