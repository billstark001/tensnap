{
  "name": "tensnap-python",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "python -m tensnap.examples.flock_viz",
    "dev:flock": "python -m tensnap.examples.flock_viz",
    "dev:hk": "python -m tensnap.examples.hk_viz",
    "dev:sirs:grid": "python -m tensnap.examples.sirs_viz_grid",
    "dev:sirs:graph": "python -m tensnap.examples.sirs_viz_graph",
    "dev:sirs:uniform": "python -m tensnap.examples.sirs_viz_uniform",
    "test": "pytest",
    "lint": "mypy tensnap && ruff check tensnap",
    "format": "ruff format tensnap",
    "clean": "rm -rf build dist *.egg-info __pycache__"
  }
}