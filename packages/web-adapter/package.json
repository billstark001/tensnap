{
  "name": "@tensnap/web-adapter",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Web utilities for TenSnap including filesystem UI and development tools",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./file-system": "./src/file-system/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./transport": "./src/transport/index.ts"
  },
  "scripts": {
    "build": "pnpm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "format": "oxfmt --write '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}'",
    "clean": "rm -rf dist node_modules",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "i18n:check": "lingui compile --strict"
  },
  "dependencies": {
    "@isomorphic-git/lightning-fs": "^4.10.3",
    "@lingui/cli": "^6.9.0",
    "@lingui/core": "^6.9.0",
    "@lingui/react": "^6.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@tensnap/core": "workspace:*",
    "@tensnap/js": "workspace:*",
    "@tensnap/protocol": "workspace:*",
    "@tensnap/web-common": "workspace:*",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.2",
    "@vitest/coverage-v8": "^5.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
