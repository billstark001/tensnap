{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@tensnap/web": ["../tensnap-web/index.ts"],
      "@tensnap/web/*": ["../tensnap-web/src/*"],
