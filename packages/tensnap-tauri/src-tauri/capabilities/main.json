{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimum desktop permissions for user-selected files, settings, and the application menu.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-theme",
    "core:event:allow-listen",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set"
  ],
  "platforms": ["linux", "macOS", "windows"]
}
