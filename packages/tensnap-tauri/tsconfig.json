{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    
    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "tensnap-web/*": ["../tensnap-web/*"],
      "tensnap-web-utils": ["../tensnap-web-utils/src/index.ts"],
      "tensnap-web-utils/*": ["../tensnap-web-utils/*"],
      "tensnap-web-utils/file-system": ["../tensnap-web-utils/src/file-system/index.ts"],
      "tensnap-web-utils/adapters": ["../tensnap-web-utils/src/adapters/index.ts"],
      "tensnap-web-utils/adapters/*": ["../tensnap-web-utils/src/adapters/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
