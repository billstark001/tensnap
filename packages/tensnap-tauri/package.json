{
  "name": "@tensnap/tauri",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "echo 'No tests configured'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "format": "oxfmt --write '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}'",
    "clean": "rm -rf dist node_modules src-tauri/target",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "i18n:check": "lingui compile --strict"
  },
  "dependencies": {
    "@lingui/cli": "^6.9.0",
    "@lingui/core": "^6.9.0",
    "@lingui/react": "^6.9.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-fs": "2.6.0",
    "@tauri-apps/plugin-store": "2.5.0",
    "@tensnap/web": "workspace:*",
    "@tensnap/web-common": "workspace:*",
    "leafer-ui": "^2.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@lingui/swc-plugin": "^6.7.0",
    "@lingui/vite-plugin": "^6.9.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
