    "preview": "vite preview",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@preact/signals": "^2.9.3",
    "@tensnap/core": "workspace:*",
