{
  "name": "@tensnap/benchmark",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "exports": {
    "./harness": "./src/harness/index.ts"
  },
  "scripts": {
    "bench": "node --import tsx src/cli.ts",
    "bench:smoke": "node --import tsx src/cli.ts run --profile benchmarks/profiles/smoke.json",
    "bench:browser:all": "node --import tsx src/cli.ts run --profile benchmarks/profiles/browser-all-v0.3.json",
    "bench:browser:install": "playwright install chromium",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "build": "tsc && vite build",
    "format": "oxfmt --write '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}'",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@leafer-ui/core": "^2.3.0",
    "@lingui/react": "^6.9.0",
    "@tensnap/core": "workspace:*",
    "@tensnap/js": "workspace:*",
    "@tensnap/protocol": "workspace:*",
    "@tensnap/web": "workspace:*",
    "@tensnap/web-common": "workspace:*",
    "leafer-ui": "^2.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@lingui/swc-plugin": "^6.7.0",
    "@lingui/vite-plugin": "^6.9.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
