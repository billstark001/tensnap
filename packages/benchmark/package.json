    "@tensnap/web-common": "workspace:*",
    "leafer-ui": "^2.2.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@lingui/swc-plugin": "^6.5.1",
