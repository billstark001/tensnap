{
  "name": "@tensnap/agent",
  "version": "0.3.8",
  "description": "Headless TenSnap simulator CLI with bounded runs, scene rendering, recordings, and offline agent skills.",
  "keywords": [
    "agent",
    "automation",
    "cli",
    "tensnap"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billstark001/tensnap.git",
    "directory": "packages/tensnap-agent"
  },
  "bin": {
    "tensnap-agent": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./session": "./dist/session/index.js"
  },
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "node ./scripts/build.mjs",
    "skills:sync": "node ./scripts/sync-skills.mjs",
    "skills:check": "node ./scripts/sync-skills.mjs --check",
    "test:package": "pnpm run build && node ./scripts/verify-package.mjs",
    "test:package:ecosystem": "pnpm run build && node ./scripts/verify-package.mjs --ecosystem",
    "cli": "pnpm run build && node ./dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run typecheck",
    "format": "oxfmt --write '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}'",
    "clean": "rm -rf dist node_modules",
    "test:recording-workflow": "pnpm run build && node ./scripts/verify-recording-workflow.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@leafer-ui/core": "^2.3.0",
    "@leafer-ui/node": "^2.3.0",
    "@tensnap/core": "workspace:*",
    "@tensnap/network": "workspace:*",
    "@tensnap/protocol": "workspace:*",
    "canvas": "^3.2.3",
    "commander": "^14.0.3",
    "hono": "^4.13.13",
    "write-file-atomic": "^6.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
