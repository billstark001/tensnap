{
  "name": "@tensnap/agent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Scene-centric CLI runtime for TenSnap automation agents.",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./session": "./dist/session/index.js"
  },
  "bin": {
    "tensnap-agent": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "node ./scripts/build.mjs",
    "cli": "pnpm run build && node ./dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run typecheck",
    "format": "echo 'No formatter configured'",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@leafer-ui/core": "^2.2.2",
    "@leafer-ui/node": "^2.2.2",
    "@tensnap/core": "workspace:*",
    "@tensnap/protocol": "workspace:*",
    "canvas": "^3.2.3",
    "hono": "^4.12.30",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "tensnap",
    "cli",
    "agent",
    "automation"
  ]
}
