{
  "name": "@tensnap/js",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "JavaScript bindings and postMessage transport primitives for TenSnap",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bindings": "./src/bindings/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./scenario": "./src/scenario/index.ts",
    "./transport": "./src/transport/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@tensnap/core": "workspace:*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}