{
  "name": "@tensnap/js",
  "version": "0.3.0",
  "type": "module",
  "description": "JavaScript bindings and postMessage transport primitives for TenSnap",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bindings": "./src/bindings/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./scenario": "./src/scenario/index.ts",
    "./transport": "./src/transport/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "format": "echo 'No formatter configured'",
    "clean": "rm -rf dist node_modules"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./bindings": {
        "types": "./dist/bindings/index.d.ts",
        "import": "./dist/bindings/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime/index.d.ts",
        "import": "./dist/runtime/index.js"
      },
      "./scenario": {
        "types": "./dist/scenario/index.d.ts",
        "import": "./dist/scenario/index.js"
      },
      "./transport": {
        "types": "./dist/transport/index.d.ts",
        "import": "./dist/transport/index.js"
      }
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@tensnap/protocol": "workspace:*",
    "@types/ws": "^8.18.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
