{
  "name": "tensnap",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter tensnap-web dev",
    "build:web": "pnpm --filter tensnap-web build",
    "test:web": "pnpm --filter tensnap-web test",
    "dev:tauri": "pnpm --filter tensnap-tauri dev",
    "build:tauri": "pnpm --filter tensnap-tauri build",
    "dev:py:flock": "pnpm --filter tensnap-python dev:flock",
    "dev:py:hk": "pnpm --filter tensnap-python dev:hk",
    "dev:py:cgol": "pnpm --filter tensnap-python dev:cgol",
    "dev:py:sugarscape": "pnpm --filter tensnap-python dev:sugarscape",
    "dev:py:sirs:grid": "pnpm --filter tensnap-python dev:sirs:grid",
    "dev:py:sirs:graph": "pnpm --filter tensnap-python dev:sirs:graph",
    "dev:py:sirs:uniform": "pnpm --filter tensnap-python dev:sirs:uniform",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}