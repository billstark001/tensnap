{
  "name": "tensnap",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @tensnap/web dev",
    "build:web": "pnpm --filter @tensnap/web build",
    "preview:web": "pnpm --filter @tensnap/web preview",
    "test:web": "pnpm --filter @tensnap/web test",
    "dev:agent": "pnpm --filter @tensnap/agent dev",
    "test:agent": "pnpm --filter @tensnap/agent test",
    "dev:benchmark": "pnpm --filter @tensnap/benchmark dev",
    "build:benchmark": "pnpm --filter @tensnap/benchmark build",
    "dev:tauri": "pnpm --filter @tensnap/tauri dev",
    "build:tauri": "pnpm --filter @tensnap/tauri build",
    "dev:py:flock": "cd examples/python && python flock_viz.py",
    "dev:py:hk": "cd examples/python && python hk_viz.py",
    "dev:py:sirs:grid": "cd examples/python && python sirs_viz_grid.py",
    "dev:py:sirs:graph": "cd examples/python && python sirs_viz_graph.py",
    "dev:py:cgol": "cd examples/python_mesa && python cgol_viz.py",
    "dev:py:sugarscape": "cd examples/python_mesa && python sugarscape_viz.py",
    "dev:py:mushroom": "cd examples/python_mesa && python mushroom_viz.py",
    "i18n:extract": "pnpm -r i18n:extract",
    "i18n:compile": "pnpm -r i18n:compile",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "update-icons": "node scripts/update-icons.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "vite-prerender-plugin": "0.5.13"
    },
    "ignoredBuiltDependencies": [
      "sharp"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}