{
  "name": "tensnap",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/js"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @tensnap/web dev",
    "build:web": "pnpm --filter @tensnap/web build",
    "preview:web": "pnpm --filter @tensnap/web preview",
    "test:web": "pnpm --filter @tensnap/web test",
    "dev:agent": "pnpm --filter @tensnap/agent dev",
    "build:agent": "pnpm --filter @tensnap/agent build",
    "cli:agent": "pnpm --filter @tensnap/agent cli",
    "test:agent": "pnpm --filter @tensnap/agent test",
    "dev:benchmark": "pnpm --filter @tensnap/benchmark dev",
    "build:benchmark": "pnpm --filter @tensnap/benchmark build",
    "preview:benchmark": "pnpm --filter @tensnap/benchmark preview",
    "benchmark:prod": "pnpm run build:benchmark && pnpm run preview:benchmark",
    "dev:tauri": "pnpm --filter @tensnap/tauri dev",
    "build:tauri": "pnpm --filter @tensnap/tauri build",
    "dev:py:random-walk": "cd examples/python && python random_walk_viz.py",
    "dev:py:flock": "cd examples/python && python flock_viz.py",
    "dev:py:hk": "cd examples/python && python hk_viz.py",
    "dev:py:predator-prey": "cd examples/python && python predator_prey_viz.py",
    "dev:py:sirs:grid": "cd examples/python && python sirs_viz_grid.py",
    "dev:py:sirs:graph": "cd examples/python && python sirs_viz_graph.py",
    "dev:py:cgol": "cd examples/python_mesa && python cgol_viz.py",
    "dev:py:sugarscape": "cd examples/python_mesa && python sugarscape_viz.py",
    "dev:py:mushroom": "cd examples/python_mesa && python mushroom_viz.py",
    "dev:py:schelling": "cd examples/python_mesa && python schelling_viz.py",
    "dev:py:schelling:solara": "cd examples/python_mesa && solara run schelling_viz_solara.py",
    "standalone:py:schelling": "cd examples/python_mesa && python schelling_standalone.py",
    "standalone:netlogo:schelling": "cd examples/python_mesa && python schelling_netlogo_standalone.py",
    "dev:py:evac-dqn": "cd examples && python -m python_dqn.evac_viz",
    "dev:py:evac-dqn:solara": "cd examples && solara run python_dqn/evac_viz_solara.py",
    "dev:netlogo:evac-dqn": "open -a '/Applications/NetLogo 7.0.4/NetLogo 7.0.4.app' examples/python_dqn/netlogo/evac_dqn_netlogo.nlogox",
    "dev:go:schelling": "cd examples/go && make run-schelling",
    "standalone:go:schelling": "cd examples/go && make run-standalone",
    "dev:js:schelling": "pnpm --filter @tensnap/examples-js demo:ws schelling",
    "dev:js:wolf-sheep": "pnpm --filter @tensnap/examples-js demo:ws wolf-sheep",
    "dev:js:axelrod": "pnpm --filter @tensnap/examples-js demo:ws axelrod",
    "dev:js:tornberg": "pnpm --filter @tensnap/examples-js demo:ws tornberg",
    "i18n:extract": "pnpm -r i18n:extract",
    "i18n:compile": "pnpm -r i18n:compile",
    "i18n:check": "pnpm -r --if-present i18n:check",
    "i18n:verify": "pnpm i18n:extract && pnpm i18n:check",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "update-icons": "node scripts/update-icons.mjs",
    "release": "node scripts/release.mjs",
    "dev:julia:el-farol": "pnpm --dir examples/julia run demo:el-farol",
    "dev:julia:schelling": "pnpm --dir examples/julia run demo:schelling",
    "dev:julia:schelling:makie": "pnpm --dir examples/julia run demo:schelling:makie",
    "standalone:julia:schelling": "pnpm --dir examples/julia run standalone:schelling",
    "release:julia": "node scripts/release.mjs julia",
    "release:protocol": "node scripts/release.mjs protocol",
    "release:core": "node scripts/release.mjs core",
    "release:js": "node scripts/release.mjs js",
    "test:julia": "pnpm --dir examples/julia run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
